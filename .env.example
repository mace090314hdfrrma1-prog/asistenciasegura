#.env.example
#1. Copia este archivo y renombralo a .env(sin example)
#2. Llena los valores de TU equipo
#3. el archivo .env NUNCA se sube a Github

#Llave para firmar la sesion. Pon una frase larga y diferente por equipo

SECRET_KEY=cambia-esta-frase-por-una-larga-y-secreta

# 1 = modo desarrollo (errores detallados y ruta /dev/entrar). En Render va 0

MODO_DESARROLLO=1

# --- BASE DE DATOS ---
#Opcion A: XAMPP Local -> DB_HOST=Localhost DB_PORT=3306 DB_USER= root DB_PASSWORD= (vacio)
#Opcion B: Aiven       -> Los datos de "conection information" del servicio

DB_HOST=Localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# Cada equipo usa la suya  asist_e1, asist_e2... asist_e6

DB_NAME=asist_e5
#solo para Aiven: ruta al archivo ca.pem que se descarga del servicio. Con XAMP dejalo vacio.

DB_SS_CA=

# --- Clave que manda el ESP32 EN EL ENCABEZADO x-Clave-Dispositivo---

CLAVE_DISPOSITIVO=clave-de-prueba-esp32